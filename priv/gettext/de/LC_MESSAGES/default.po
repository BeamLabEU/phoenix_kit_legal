msgstr "Speichert Ihre Datenschutzauswahl"

#: lib/phoenix_kit_legal/legal.ex:1003
#, elixir-autogen, elixir-format
msgid "Stores your privacy choices for this browser"
msgstr "Speichert Ihre Datenschutzauswahl für diesen Browser"

#: lib/phoenix_kit_legal/web/settings.html.heex:939
